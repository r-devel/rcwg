    {
        "user": "U04RM6HJ5GT",
        "type": "message",
        "ts": "1783348197.775449",
        "client_msg_id": "4d05a5fd-3975-4030-b009-427384f6e1d8",
        "text": "```library(data.table)\n#&gt;\n#&gt; Attaching package: 'data.table'\n#&gt; The following object is masked from 'package:base':\n#&gt;\n#&gt;     %notin%\n\nx &lt;- sample(letters, 1e3, replace = TRUE)\n\nmicrobenchmark::microbenchmark(\n  \"a\" %in% x,\n  any(\"a\" == x),\n  \"a\" %chin% x,\n  times = 1e5\n)\n#&gt; Unit: nanoseconds\n#&gt;           expr  min   lq      mean median   uq     max neval\n#&gt;     \"a\" %in% x 1587 3349 4137.9980   3723 4107 3549957 1e+05\n#&gt;  any(\"a\" == x) 1450 2267 2675.4236   2476 2728 3290173 1e+05\n#&gt;   \"a\" %chin% x  707  791  919.1185    866  956  187171 1e+05\n\ny &lt;- c(\"a\", x)\n\nmicrobenchmark::microbenchmark(\n  \"a\" %in% y,\n  any(\"a\" == y),\n  \"a\" %chin% y,\n  times = 1e5\n)\n#&gt; Unit: nanoseconds\n#&gt;           expr  min   lq     mean median   uq     max neval\n#&gt;     \"a\" %in% y 1613 1935 2465.125   2081 2245 2542694 1e+05\n#&gt;  any(\"a\" == y) 1445 1609 1920.930   1720 1873 2313625 1e+05\n#&gt;   \"a\" %chin% y  700  908 1205.264   1256 1414  154565 1e+05```\n",
        "team": "T01DW9DLB2A",
        "user_team": "T01DW9DLB2A",
        "source_team": "T01DW9DLB2A",
        "user_profile": {
            "avatar_hash": "404083940b4a",
            "image_72": "https:\/\/avatars.slack-edge.com\/2023-02-28\/4864855297894_404083940b4acb373c0f_72.jpg",
            "first_name": "Hugo",
            "real_name": "Hugo Gruson",
            "display_name": "Hugo Gruson",
            "team": "T01DW9DLB2A",
            "name": "hugo",
            "is_restricted": false,
            "is_ultra_restricted": false
        },
        "thread_ts": "1783331348.411469",
        "parent_user_id": "U04RM6HJ5GT",
        "blocks": [
            {
                "type": "rich_text",
                "block_id": "7chYN",
                "elements": [
                    {
                        "type": "rich_text_preformatted",
                        "elements": [
                            {
                                "type": "text",
                                "text": "library(data.table)\n#>\n#> Attaching package: 'data.table'\n#> The following object is masked from 'package:base':\n#>\n#>     %notin%\n\nx <- sample(letters, 1e3, replace = TRUE)\n\nmicrobenchmark::microbenchmark(\n  \"a\" %in% x,\n  any(\"a\" == x),\n  \"a\" %chin% x,\n  times = 1e5\n)\n#> Unit: nanoseconds\n#>           expr  min   lq      mean median   uq     max neval\n#>     \"a\" %in% x 1587 3349 4137.9980   3723 4107 3549957 1e+05\n#>  any(\"a\" == x) 1450 2267 2675.4236   2476 2728 3290173 1e+05\n#>   \"a\" %chin% x  707  791  919.1185    866  956  187171 1e+05\n\ny <- c(\"a\", x)\n\nmicrobenchmark::microbenchmark(\n  \"a\" %in% y,\n  any(\"a\" == y),\n  \"a\" %chin% y,\n  times = 1e5\n)\n#> Unit: nanoseconds\n#>           expr  min   lq     mean median   uq     max neval\n#>     \"a\" %in% y 1613 1935 2465.125   2081 2245 2542694 1e+05\n#>  any(\"a\" == y) 1445 1609 1920.930   1720 1873 2313625 1e+05\n#>   \"a\" %chin% y  700  908 1205.264   1256 1414  154565 1e+05"
                            }
                        ],
                        "border": 0
                    },
                    {
                        "type": "rich_text_section",
                        "elements": []
                    }
                ]
            }
        ]
    },
