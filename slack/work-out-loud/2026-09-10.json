    {
        "user": "U081Z9041A5",
        "type": "message",
        "ts": "1789081961.238369",
        "client_msg_id": "20d33684-9d9a-4651-bf2c-9b8cfc2ec6bf",
        "text": "That is the final step. Bugzilla emails go to all R Core member AFAIK. But yes, one-off initial cost of getting a handle to submit (because spammers...)\n\nAlternatively, you could set up a quick GH repo for the patch, or fork the r-devel repo at GH, and comment on your PR, changes and results in a markdown document (or gist).  And then email the r-devel list to get in front of the same crowd.",
        "team": "T01DW9DLB2A",
        "user_team": "T01DW9DLB2A",
        "source_team": "T01DW9DLB2A",
        "user_profile": {
            "avatar_hash": "g4e96ca7ae02",
            "image_72": "https:\/\/secure.gravatar.com\/avatar\/4e96ca7ae02c37e7d940d17997d780e5.jpg?s=72&d=https%3A%2F%2Fa.slack-edge.com%2Fdf10d%2Fimg%2Favatars%2Fava_0023-72.png",
            "first_name": "Dirk",
            "real_name": "Dirk Eddelbuettel",
            "display_name": "Dirk Eddelbuettel",
            "team": "T01DW9DLB2A",
            "name": "edd",
            "is_restricted": false,
            "is_ultra_restricted": false
        },
        "thread_ts": "1788992168.013759",
